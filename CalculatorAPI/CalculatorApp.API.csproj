<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Prevents PowerShell pipeline from halting during migrations -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903;NU1510</WarningsNotAsErrors>
		<NoWarn>$(NoWarn);NU1510;NU1903</NoWarn>

		<!-- Disables NuGet Audit from failing builds on transitive dependency warnings -->
		<NuGetAudit>true</NuGetAudit>
		<NuGetAuditLevel>critical</NuGetAuditLevel>
		<UserSecretsId>24d02a08-c8e3-4a7d-9e2b-9f9bc8b22b53</UserSecretsId>
		<DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.0.0" />

		<!-- Forces the project to use the secure, patched version of the library -->
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.9" />
	</ItemGroup>

	<ItemGroup>
		<!-- Suppresses the specific GitHub advisory warning for the linked project -->
		<NuGetAuditSuppress Include="https://github.com" />
		<ProjectReference Include="..\CalculatorApp.Service\CalculatorApp.Service.csproj" />
		<ProjectReference Include="..\CalculatorMigrations\CalculatorApp.Migrationss.csproj" />
	</ItemGroup>

</Project>
